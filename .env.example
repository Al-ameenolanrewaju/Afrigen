# ===========================================================================
# Afrigen content distribution — environment variables
# ===========================================================================
# Copy to .env and fill in real values. Any platform whose variables are left
# blank is skipped gracefully at runtime — it never blocks the rest of a run.

# --- AI content generation ---
GROQ_API_KEY=
# Optional; use a model available to your Groq account.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Free-tier image generation ---
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=auto

# ---------------------------------------------------------------------------
# ACTIVE distribution platforms
# ---------------------------------------------------------------------------

# --- Telegram (broadcast channel + admin notifications) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=

# --- LinkedIn ---
# NOTE: access tokens expire every ~60 days — regenerate before expiry.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match the Redirect URI registered in LinkedIn Developer Portal.
LINKEDIN_REDIRECT_URI=https://your-public-domain.com/connected-accounts/linkedin/callback
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=SUbeWeE2ks

# --- Dev.to ---
DEVTO_API_KEY=

# --- Hashnode ---
# NOTE: currently DISABLED — Hashnode retired its free GraphQL API. These are
# kept for when the paid API tier is subscribed; leave blank otherwise.
HASHNODE_API_TOKEN=
HASHNODE_PUBLICATION_ID=

# --- Google Indexing (pings Google to crawl new posts faster) ---
# Full service-account JSON key, on one line, for a service account that is an
# Owner of afrigen.com.ng in Google Search Console with the Indexing API enabled.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Automatic trigger (Flask publish → GitHub Actions)
# ---------------------------------------------------------------------------
# A GitHub personal access token with `repo` scope. When set, publishing a blog
# post from the admin panel fires the distribute-content workflow automatically
# via repository_dispatch. Leave blank to rely on the manual workflow_dispatch.
GITHUB_DISPATCH_TOKEN=

# --- Pinterest (ACTIVE) ---
# Renders a branded card per post and pins it linking back to the blog. Skipped
# gracefully if PINTEREST_ACCESS_TOKEN is blank. PINTEREST_BOARD_ID is optional —
# the first available board is auto-selected when it's unset.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Must exactly match the Redirect URI registered in Pinterest Developer Portal.
PINTEREST_REDIRECT_URI=https://your-public-domain.com/connected-accounts/pinterest/callback

# --- TikTok OAuth ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match the Redirect URI registered in TikTok Developer Center.
TIKTOK_REDIRECT_URI=https://your-public-domain.com/connected-accounts/tiktok/callback
# Must include video.publish for video posting and require TikTok approval.
TIKTOK_SCOPE=user.info.basic,video.publish

# Used when the app is behind a proxy or users access it through multiple hosts.
# TikTok's redirect URI comparison is exact.
APP_BASE_URL=https://your-public-domain.com

# --- WhatsApp / Twilio ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+15551234567
WHATSAPP_AUTO_REPLY_ENABLED=false
WHATSAPP_AWAY_MESSAGE=Thanks for messaging us. We are away right now, but we will reply as soon as we can.
CONNECTED_ACCOUNTS_ENCRYPTION_KEY=IslsVkwyL4D6O6EmRod-7dbjr8KfSmtZJGWCHT7CFpc=

